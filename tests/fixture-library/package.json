{
  "name": "@rinka-tests/fixture-library",
  "private": true,
  "files": [
    "src",
    "types"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "types": "./types/*.d.ts",
      "default": "./src/elements/*.tsx"
    }
  },
  "scripts": {
    "types": "rinka prepare && tsc -p .rinka/tsconfig.elements.json --composite false --declaration --rootDir src/elements --outDir types"
  },
  "dependencies": {
    "rinka": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "rinka": {
    "prefix": "acme",
    "elements": "src/elements"
  }
}
