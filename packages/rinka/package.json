{
  "name": "rinka",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "rinka": "./lib/build/bin.js"
  },
  "files": [
    "lib",
    "tsconfig.app.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "rinka-server": {
        "types": "./lib/server/index.d.ts",
        "default": "./lib/server/index.js"
      },
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./jsx-runtime": {
      "rinka-shared": {
        "types": "./lib/shared/jsx-runtime.d.ts"
      },
      "rinka-server": {
        "types": "./lib/server/jsx-runtime.d.ts",
        "default": "./lib/server/jsx-runtime.js"
      },
      "types": "./lib/client/jsx-runtime.d.ts",
      "default": "./lib/client/jsx-runtime.js"
    },
    "./server": {
      "rinka-client": {
        "types": "./lib/client/server-api.d.ts"
      },
      "types": "./lib/server/api.d.ts",
      "default": "./lib/server/api.js"
    },
    "./app": {
      "types": "./lib/server/virtual-app.d.ts",
      "default": "./lib/server/virtual-app.js"
    },
    "./router": {
      "types": "./lib/shared/router.d.ts",
      "default": "./lib/shared/router.js"
    },
    "./vite": {
      "types": "./lib/build/plugin.d.ts",
      "default": "./lib/build/plugin.js"
    },
    "./tsconfig.json": "./tsconfig.app.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "generate": "node scripts/generate-dom-names.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@solidjs/signals": "catalog:",
    "magic-string": "catalog:",
    "seroval": "catalog:"
  },
  "devDependencies": {
    "@rinka/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "hono": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "hono": "catalog:",
    "typescript": ">=7.1.0-beta <7.2.0-0",
    "vite": "catalog:"
  }
}
